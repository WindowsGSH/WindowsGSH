<ui:FluentWindow x:Class="WindowsGSH.ApiActionsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="API Actions"
                 Width="980"
                 Height="720"
                 MinWidth="860"
                 MinHeight="620"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 Icon="WindowsGSH.ico"
                 Background="{DynamicResource WorkspaceBrush}">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- See ExitDecisionWindow.xaml for why this is merged locally, not in App.xaml. -->
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource WorkspaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="ApiActionsTitleBar"
                     Grid.Row="0"
                     Title="API Actions"
                     Background="{DynamicResource WindowChromeBrush}"
                     Foreground="{DynamicResource TopBarTextBrush}"
                     ButtonsForeground="{DynamicResource TopBarTextBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="WindowsGSH.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1"
              Margin="22"
              Background="{DynamicResource WorkspaceBrush}"
              TextElement.Foreground="{DynamicResource TextBrush}"
              PreviewMouseLeftButtonDown="ContentGrid_PreviewMouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleTextBlock" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="SubtitleTextBlock" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <ListBox x:Name="ActionsListBox"
                             BorderThickness="0"
                             Background="Transparent"
                             DisplayMemberPath="Label"
                             SelectionChanged="ActionsListBox_SelectionChanged" />
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock x:Name="ActionTitleTextBlock" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="ActionDescriptionTextBlock" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                            <StackPanel x:Name="ParametersPanel" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="RunButton"
                            Grid.Row="1"
                            Content="Run"
                            Width="110"
                            Height="34"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,12"
                            IsDefault="True"
                            Style="{StaticResource DialogPrimaryButton}"
                            Click="RunButton_Click" />

                    <Border Grid.Row="2" Background="#101218" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <TextBox x:Name="OutputTextBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#DDE7F5"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                <Button Content="Close"
                        Width="92"
                        Height="34"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Style="{StaticResource DialogSecondaryButton}"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
