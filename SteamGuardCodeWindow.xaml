<ui:FluentWindow
    x:Class="WindowsGSH.SteamGuardCodeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Steam Guard Required"
    Width="420"
    Height="280"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True"
    Icon="WindowsGSH.ico"
    Background="{DynamicResource WorkspaceBrush}"
    WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- See ExitDecisionWindow.xaml for why this is merged locally, not in App.xaml. -->
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource WorkspaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Steam Guard Required"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     CanMaximize="False"
                     Background="{DynamicResource WindowChromeBrush}"
                     Foreground="{DynamicResource TopBarTextBrush}"
                     ButtonsForeground="{DynamicResource TopBarTextBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="WindowsGSH.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="DescriptionTextBlock"
                       Foreground="{DynamicResource TextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />

            <TextBlock Grid.Row="1"
                       x:Name="AccountTextBlock"
                       Foreground="{DynamicResource TextBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Code: "
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="CodeTextBox"
                             Width="160"
                             MaxLength="16"
                             CharacterCasing="Upper"
                             VerticalAlignment="Center"
                             KeyDown="CodeTextBox_KeyDown" />
                    <Button x:Name="SubmitButton"
                            Content="Submit"
                            Width="70"
                            IsDefault="True"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource DialogPrimaryButton}"
                            Click="SubmitButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock"
                           TextWrapping="Wrap"
                           Foreground="Gray"
                           FontSize="11" />
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Content="Cancel update"
                        Width="100"
                        IsCancel="True"
                        Style="{StaticResource DialogSecondaryButton}"
                        Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
