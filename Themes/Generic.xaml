<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:WindowsGSH">
    <Style TargetType="{x:Type local:ServerRow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ServerRow}">
                    <Border BorderBrush="#D8E0E7" BorderThickness="0,0,0,1" Background="White">
                        <Grid MinHeight="76" Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="8" Background="{TemplateBinding Accent}">
                                    <TextBlock Text="{TemplateBinding GameInitial}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="{TemplateBinding GameName}" FontWeight="Bold" />
                                    <TextBlock Text="{TemplateBinding Detail}" Foreground="#657384" FontSize="13" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="BadgeBorder"
                                    Grid.Column="1"
                                    Background="#E5F6EF"
                                    CornerRadius="10"
                                    Padding="8,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="BadgeText" Text="{TemplateBinding Badge}" Foreground="#0A7354" FontSize="12" FontWeight="Bold" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding Players}" Foreground="#657384" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{TemplateBinding Version}" Foreground="#657384" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Start" MinHeight="32" Padding="10,0" BorderBrush="#D8E0E7" BorderThickness="1" Background="White" FontWeight="SemiBold" />
                                <Button Content="Files" MinHeight="32" Padding="10,0" BorderBrush="#D8E0E7" BorderThickness="1" Background="White" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Warning" Value="True">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="#FFF1DF" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="#B75F13" />
                        </Trigger>
                        <Trigger Property="Muted" Value="True">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="#EDF1F4" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="#5D6975" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
