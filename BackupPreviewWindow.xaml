<ui:FluentWindow x:Class="WindowsGSH.BackupPreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Backup Preview"
                 Width="980"
                 Height="700"
                 MinWidth="860"
                 MinHeight="560"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 Icon="WindowsGSH.ico"
                 Background="{DynamicResource WorkspaceBrush}">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- See ExitDecisionWindow.xaml for why this is merged locally, not in App.xaml. -->
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource WorkspaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Backup Preview"
                     Background="{DynamicResource WindowChromeBrush}"
                     Foreground="{DynamicResource TopBarTextBrush}"
                     ButtonsForeground="{DynamicResource TopBarTextBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="WindowsGSH.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1"
              Margin="22"
              Background="{DynamicResource WorkspaceBrush}"
              TextElement.Foreground="{DynamicResource TextBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Backup Preview" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="SubtitleTextBlock" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="5" Margin="0,18,0,0">
                <Border Margin="0,0,10,0" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Restorable Files" Opacity="0.68" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="FileCountTextBlock" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="File Targets" Opacity="0.68" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="FileTargetCountTextBlock" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Folder Targets" Opacity="0.68" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="FolderCountTextBlock" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Size" Opacity="0.68" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="SizeTextBlock" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Restore Changes" Opacity="0.68" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="ScopeTextBlock" Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="14" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="160" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Backup Targets" FontWeight="SemiBold" />
                        <ListBox x:Name="FolderSummaryListBox"
                                 Grid.Row="1"
                                 Margin="0,10,0,14"
                                 Background="{DynamicResource PanelAltBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrushSoft}" />
                        <TextBlock Grid.Row="2" Text="Manifest" FontWeight="SemiBold" />
                        <TextBox x:Name="ManifestTextBox"
                                 Grid.Row="3"
                                 Margin="0,10,0,0"
                                 Background="{DynamicResource PanelAltBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrushSoft}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="14,0,0,0" Padding="14" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Files That Would Be Restored" FontWeight="SemiBold" />
                        <TextBox x:Name="FilesTextBox"
                                 Grid.Row="1"
                                 Margin="0,10,0,0"
                                 Background="{DynamicResource PanelAltBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrushSoft}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Close" Width="110" Style="{StaticResource DialogPrimaryButton}" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
