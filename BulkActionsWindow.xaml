<ui:FluentWindow x:Class="WindowsGSH.BulkActionsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Bulk Server Actions"
                 Width="940"
                 Height="680"
                 MinWidth="820"
                 MinHeight="560"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 Icon="WindowsGSH.ico"
                 Background="{DynamicResource WorkspaceBrush}">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- See ExitDecisionWindow.xaml for why this is merged locally, not in App.xaml. -->
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource WorkspaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Bulk Server Actions"
                     Background="{DynamicResource WindowChromeBrush}"
                     Foreground="{DynamicResource TopBarTextBrush}"
                     ButtonsForeground="{DynamicResource TopBarTextBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="WindowsGSH.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="22" TextElement.Foreground="{DynamicResource TextBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Bulk Server Actions"
                           FontSize="25"
                           FontWeight="Bold" />
                <TextBlock Text="Review which servers will run or be skipped before starting the batch."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Action"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <ComboBox x:Name="ActionComboBox"
                          Grid.Column="1"
                          MinHeight="36"
                          DisplayMemberPath="Label"
                          SelectionChanged="ActionComboBox_SelectionChanged" />
                <TextBlock x:Name="PlanSummaryTextBlock"
                           Grid.Column="2"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8">
                <DataGrid x:Name="ServersGrid"
                          ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Extended"
                          Background="{DynamicResource PanelBrush}"
                          Foreground="{DynamicResource TextBrush}"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Use" Width="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.CanSelectServers, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppCheckBox}"
                                              Click="ServerSelectionCheckBox_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Server"
                                            Binding="{Binding ServerName}"
                                            IsReadOnly="True"
                                            Width="2*" />
                        <DataGridTextColumn Header="Current state"
                                            Binding="{Binding CurrentState}"
                                            IsReadOnly="True"
                                            Width="145" />
                        <DataGridTextColumn Header="Plan"
                                            Binding="{Binding PlanState}"
                                            IsReadOnly="True"
                                            Width="100" />
                        <DataGridTextColumn Header="Reason / result"
                                            Binding="{Binding Detail}"
                                            IsReadOnly="True"
                                            Width="3*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <ProgressBar x:Name="ProgressBar"
                                 Width="360"
                                 Height="8"
                                 HorizontalAlignment="Left"
                                 Minimum="0"
                                 Maximum="1"
                                 Visibility="Collapsed" />
                    <TextBlock x:Name="StatusTextBlock"
                               Margin="0,7,12,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="CancelBatchButton"
                            Content="Cancel batch"
                            Width="120"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Style="{StaticResource DialogSecondaryButton}"
                            Click="CancelBatchButton_Click" />
                    <Button x:Name="RunButton"
                            Content="Run action"
                            Width="112"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Style="{StaticResource DialogPrimaryButton}"
                            Click="RunButton_Click" />
                    <Button x:Name="CloseButton"
                            Content="Close"
                            Width="92"
                            IsCancel="True"
                            Style="{StaticResource DialogSecondaryButton}"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
