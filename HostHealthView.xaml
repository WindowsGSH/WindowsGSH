<UserControl x:Class="WindowsGSH.HostHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WorkspaceBrush}">
    <!-- MainWindow's local ui:ControlsDictionary merge (Tier 4 Sub-chunk 17) cascades into this
         embedded UserControl's unstyled Buttons too - left un-overridden deliberately, see
         AppSettingsView.xaml for why a wholesale MahApps re-merge was reverted rather than kept:
         plain Buttons have no documented crash class under WPF-UI's implicit styling. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Margin="32,28,32,20">
            <StackPanel>
                <TextBlock Text="Host Health" Foreground="{DynamicResource TextBrush}" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Live host metrics, system checks, and storage overview." Foreground="{DynamicResource MutedTextBrush}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                <TextBlock x:Name="UpdatedTextBlock"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Button x:Name="CopyReportButton"
                        Content="Copy health report"
                        Click="CopyReportButton_Click"
                        Padding="12,6"
                        FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,0,32,28">

                <!-- Health warnings panel (hidden when no warnings) -->
                <Border x:Name="WarningsBorder"
                        Background="{DynamicResource BadMetricBackground}"
                        BorderBrush="{DynamicResource BadMetricBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,18"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Health warnings" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl x:Name="WarningsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,2,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Live metrics row -->
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="CPU" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="SummaryCpuTextBlock" Text="--" Foreground="{DynamicResource TextBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock x:Name="SummaryCpuDetailTextBlock" Text="Loading..." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="MEMORY" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="SummaryMemoryTextBlock" Text="--" Foreground="{DynamicResource TextBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock Text="Used / total physical memory" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,20,0">
                            <TextBlock Text="APP DRIVE" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="SummaryDriveTextBlock" Text="--" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <TextBlock x:Name="SummaryDriveDetailTextBlock" Text="Loading..." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="WINDOWSGSH" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="SummaryAppTextBlock" Text="--" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <TextBlock Text="App CPU / private working memory" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CPU chart -->
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="CPU Usage" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Total host CPU — last ~60 minutes (4-second samples)" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="CpuChartValueTextBlock"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="Bold" />
                        </Grid>
                        <Border Background="{DynamicResource WorkspaceBrush}" CornerRadius="8" Padding="12">
                            <Viewbox Stretch="Fill" Height="80">
                                <Canvas x:Name="CpuChartCanvas" Width="900" Height="80">
                                    <Polyline x:Name="CpuChartLine" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="100%" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                            <TextBlock Text="0%" HorizontalAlignment="Left" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Memory chart -->
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Memory Usage" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Host physical memory — last ~60 minutes" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="MemoryChartValueTextBlock"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="Bold" />
                        </Grid>
                        <Border Background="{DynamicResource WorkspaceBrush}" CornerRadius="8" Padding="12">
                            <Viewbox Stretch="Fill" Height="80">
                                <Canvas x:Name="MemoryChartCanvas" Width="900" Height="80">
                                    <Polyline x:Name="MemoryChartLine" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <Grid Margin="0,4,0,0">
                            <TextBlock x:Name="MemoryChartMaxLabel" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                            <TextBlock Text="0 GB" HorizontalAlignment="Left" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Download chart -->
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Network Download" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Host inbound bandwidth — last ~60 minutes (4-second samples)" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="DownloadChartValueTextBlock"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="Bold" />
                        </Grid>
                        <Border Background="{DynamicResource WorkspaceBrush}" CornerRadius="8" Padding="12">
                            <Viewbox Stretch="Fill" Height="80">
                                <Canvas x:Name="DownloadChartCanvas" Width="900" Height="80">
                                    <Polyline x:Name="DownloadChartLine" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <Grid Margin="0,4,0,0">
                            <TextBlock x:Name="DownloadChartMaxLabel" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                            <TextBlock Text="0 B/s" HorizontalAlignment="Left" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Upload chart -->
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Network Upload" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Host outbound bandwidth — last ~60 minutes (4-second samples)" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="UploadChartValueTextBlock"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="Bold" />
                        </Grid>
                        <Border Background="{DynamicResource WorkspaceBrush}" CornerRadius="8" Padding="12">
                            <Viewbox Stretch="Fill" Height="80">
                                <Canvas x:Name="UploadChartCanvas" Width="900" Height="80">
                                    <Polyline x:Name="UploadChartLine" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <Grid Margin="0,4,0,0">
                            <TextBlock x:Name="UploadChartMaxLabel" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                            <TextBlock Text="0 B/s" HorizontalAlignment="Left" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Two-column lower sections -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- WindowsGSH app info -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="WindowsGSH" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Version" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="AppVersionTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="App uptime" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="AppUptimeTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CPU / Memory" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="AppResourcesTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Install folder" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="AppInstallPathTextBlock" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <Button x:Name="OpenInstallFolderButton" Content="Open" Click="OpenInstallFolderButton_Click" Margin="8,0,0,0" Padding="6,2" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Servers folder" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="AppServersFolderTextBlock" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <Button x:Name="OpenServersFolderButton" Content="Open" Click="OpenServersFolderButton_Click" Margin="8,0,0,0" Padding="6,2" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Logs folder" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="AppLogsFolderTextBlock" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <Button x:Name="OpenLogsFolderButton" Content="Open" Click="OpenLogsFolderButton_Click" Margin="8,0,0,0" Padding="6,2" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Last log line" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="AppLastLogTextBlock" Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- System checks -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="System" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Operating system" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="OsVersionTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="System uptime" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="SystemUptimeTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Running as admin" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="AdminStatusTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sleep / hibernate" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="SleepStatusTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Long path support" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="LongPathTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pending reboot" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="PendingRebootTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            </Grid>
                            <Separator Margin="0,10,0,10" />
                            <TextBlock Text="Network" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Local IP" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="LocalIpTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Public IP" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="PublicIpTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="NAT warning" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="NatWarningTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Storage section -->
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Storage" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="App drive usage and server install sizes" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button x:Name="RefreshStorageButton" Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="RefreshStorageButton_Click" Padding="10,4" FontSize="12" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Drive totals -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DRIVE" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Free space" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                    <TextBlock x:Name="StorageDriveFreeTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total size" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                    <TextBlock x:Name="StorageDriveTotalTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Drive type" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                    <TextBlock x:Name="StorageDriveTypeTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Logs folder" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                    <TextBlock x:Name="StorageLogsSizeTextBlock" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                                </Grid>
                            </StackPanel>

                            <!-- Server install sizes -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SERVER INSTALLS" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock x:Name="StorageScanStatusTextBlock" Text="Press Refresh to scan" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4" />
                                <ItemsControl x:Name="ServerSizesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Server resources table -->
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Server Resources" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="CPU and memory for each managed server — sorted by memory use" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Column headers -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="80" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SERVER" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="STATUS" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="CPU" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="MEMORY" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="UPTIME" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Grid>

                        <ItemsControl x:Name="ServerResourcesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Opacity" Value="0.45" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Opacity" Value="1.0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="80" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource TextBrush}" FontSize="13" />
                                        <TextBlock Grid.Column="2" Text="{Binding Cpu}" Foreground="{DynamicResource TextBrush}" FontSize="13" />
                                        <TextBlock Grid.Column="3" Text="{Binding Memory}" Foreground="{DynamicResource TextBrush}" FontSize="13" />
                                        <TextBlock Grid.Column="4" Text="{Binding Uptime}" Foreground="{DynamicResource TextBrush}" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoServersTextBlock"
                                   Text="No servers installed yet — add servers from the Servers page."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Firewall & ports section -->
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Firewall &amp; Ports" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Checks WindowsGSH-managed firewall rules and TCP listening state for each server" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button x:Name="CheckPortsButton" Content="Check ports" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="CheckPortsButton_Click" Padding="10,4" FontSize="12" />
                        </Grid>

                        <!-- Column headers -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="80" />
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SERVER" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="PORT" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="PROTO" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="FIREWALL RULE" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="LISTENING" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Grid>

                        <ItemsControl x:Name="PortDiagnosticsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="80" />
                                            <ColumnDefinition Width="55" />
                                            <ColumnDefinition Width="55" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ServerName}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Port}" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{Binding Protocol}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                        <TextBlock Grid.Column="3" Text="{Binding FirewallStatus}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FirewallStatus}" Value="No rule">
                                                            <Setter Property="Foreground" Value="{DynamicResource BadMetricForeground}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="4" Text="{Binding ListeningStatus}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ListeningStatus}" Value="Not listening">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="PortScanStatusTextBlock"
                                   Text="Press 'Check ports' to scan firewall rules and TCP listening state."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="Note: UDP listening state cannot be verified via this tool."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
