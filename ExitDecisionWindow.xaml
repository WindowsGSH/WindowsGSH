<ui:FluentWindow x:Class="WindowsGSH.ExitDecisionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Exit WindowsGSH"
                 Width="620"
                 Height="430"
                 MinHeight="430"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 Icon="WindowsGSH.ico"
                 Background="{DynamicResource WorkspaceBrush}">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Scoped to this window only, not App.xaml - WPF-UI controls (FluentWindow,
                    TitleBar, and any other ui: control used here) have no automatic fallback
                    style (confirmed via the assembly's ThemeInfoAttribute: GenericDictionaryLocation
                    is None, so there is no Themes/Generic.xaml WPF would otherwise fall back to).
                    Without this, FluentWindow/TitleBar still construct and show without throwing,
                    but render with no chrome/button templates at all - a real runtime defect that
                    isn't visible from a build or a headless construction test. Merging
                    ui:ControlsDictionary globally in App.xaml would restyle every standard control
                    (Button/TextBox/etc.) app-wide, which the prior sub-chunk deliberately deferred -
                    so it's merged locally here instead, scoped to only this window's visual tree.
                -->
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource WorkspaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Exit WindowsGSH"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     CanMaximize="False"
                     Background="{DynamicResource WindowChromeBrush}"
                     Foreground="{DynamicResource TopBarTextBrush}"
                     ButtonsForeground="{DynamicResource TopBarTextBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="WindowsGSH.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="WindowsGSH is still managing active work"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" />

            <TextBlock x:Name="SummaryTextBlock"
                       Grid.Row="1"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />

            <Border Grid.Row="2"
                    Margin="0,18,0,18"
                    Padding="14"
                    Background="{DynamicResource PanelAltBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Stop servers and exit"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="WindowsGSH will request graceful shutdown, then force-stop a server only if it does not exit."
                               Margin="0,3,0,12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Leave servers running and exit"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Active WindowsGSH operations will be cancelled. The app and Discord bot will close, but game server processes will be left running and unmanaged."
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="100"
                        IsCancel="True"
                        Style="{StaticResource DialogSecondaryButton}"
                        Click="CancelButton_Click" />
                <Button Content="Leave Running and Exit"
                        Width="175"
                        Margin="8,0,0,0"
                        Style="{StaticResource DialogSecondaryButton}"
                        Click="LeaveRunningButton_Click" />
                <Button Content="Stop Servers and Exit"
                        Width="175"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        Style="{StaticResource DialogPrimaryButton}"
                        Click="StopServersButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
