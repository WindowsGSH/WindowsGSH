<ui:FluentWindow x:Class="WindowsGSH.InstallServerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Install Server"
                 Width="980"
                 Height="780"
                 MinWidth="920"
                 MinHeight="700"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 Icon="WindowsGSH.ico"
                 Background="{DynamicResource WorkspaceBrush}">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- See ExitDecisionWindow.xaml for why this is merged locally, not in App.xaml. -->
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource WorkspaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Install Server"
                     Background="{DynamicResource WindowChromeBrush}"
                     Foreground="{DynamicResource TopBarTextBrush}"
                     ButtonsForeground="{DynamicResource TopBarTextBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="WindowsGSH.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1"
              Margin="22"
              Background="{DynamicResource WorkspaceBrush}"
              TextElement.Foreground="{DynamicResource TextBrush}"
              PreviewMouseLeftButtonDown="ContentGrid_PreviewMouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="180" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Install Server" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="InstallDescriptionTextBlock"
                           Text="Choose a module, review its fields, then install."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Module" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox x:Name="ModuleComboBox" Grid.Column="1" MinHeight="36" DisplayMemberPath="Name" SelectionChanged="ModuleComboBox_SelectionChanged" />
                <TextBlock x:Name="SteamBranchLabel"
                           Grid.Column="2"
                           Text="Steam branch"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="18,0,8,0" />
                <Grid x:Name="SteamBranchPanel" Grid.Column="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="78" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SteamBranchComboBox" MinHeight="36" IsEditable="True" />
                    <Button x:Name="RefreshBranchesButton"
                            Grid.Column="2"
                            Content="Refresh"
                            Height="36"
                            Style="{StaticResource DialogSecondaryButton}"
                            Click="RefreshBranchesButton_Click" />
                </Grid>
                <CheckBox x:Name="CreateFirewallRulesCheckBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Content="Create Windows Firewall rules"
                          Margin="0,10,0,0"
                          VerticalAlignment="Center"
                          Style="{StaticResource AppCheckBox}" />
            </Grid>

            <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FieldsPanel" />
            </ScrollViewer>

            <Border Grid.Row="3"
                    Margin="0,16,0,0"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource PanelBrush}">
                <TextBox x:Name="LogTextBox"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource TextBrush}"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Padding="12" />
            </Border>

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Width="92" Height="34" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource DialogSecondaryButton}" Click="CloseButton_Click" />
                    <Button x:Name="InstallButton"
                            Content="Install"
                            Width="110"
                            Height="34"
                            IsDefault="True"
                            Style="{StaticResource DialogPrimaryButton}"
                            Click="InstallButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
