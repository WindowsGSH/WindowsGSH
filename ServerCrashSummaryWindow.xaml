<ui:FluentWindow x:Class="WindowsGSH.ServerCrashSummaryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Crash Detected"
                 Width="720"
                 Height="560"
                 MinWidth="520"
                 MinHeight="400"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 Icon="WindowsGSH.ico"
                 Background="{DynamicResource WorkspaceBrush}">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- See ExitDecisionWindow.xaml for why this is merged locally, not in App.xaml. -->
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource WorkspaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="CrashSummaryTitleBar"
                     Grid.Row="0"
                     Title="Crash Detected"
                     ShowMinimize="False"
                     ShowMaximize="True"
                     CanMaximize="True"
                     Background="{DynamicResource WindowChromeBrush}"
                     Foreground="{DynamicResource TopBarTextBrush}"
                     ButtonsForeground="{DynamicResource TopBarTextBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="WindowsGSH.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderTextBlock"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       TextWrapping="Wrap" />

            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Padding="14"
                    Background="{DynamicResource PanelAltBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Module"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,16,4" />
                    <TextBlock x:Name="ModuleTextBlock"
                               Grid.Column="1"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,4"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Detected"
                               Grid.Row="1"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,16,4" />
                    <TextBlock x:Name="DetectedAtTextBlock"
                               Grid.Row="1"
                               Grid.Column="1"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,4" />

                    <TextBlock Text="Exit code"
                               Grid.Row="2"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,16,4" />
                    <TextBlock x:Name="ExitCodeTextBlock"
                               Grid.Row="2"
                               Grid.Column="1"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,4" />

                    <TextBlock Text="Report"
                               Grid.Row="3"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,16,0" />
                    <TextBlock x:Name="ReportPathTextBlock"
                               Grid.Row="3"
                               Grid.Column="1"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ShowDuration="60000" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogExcerptTextBlock"
                               Margin="10"
                               FontFamily="Consolas, Courier New, monospace"
                               FontSize="11"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <TextBlock x:Name="ErrorTextBlock"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="OpenReportButton"
                            Content="Open Report"
                            Width="120"
                            Style="{StaticResource DialogSecondaryButton}"
                            Click="OpenReportButton_Click" />
                    <Button Content="Copy Diagnostics"
                            Width="140"
                            Margin="8,0,0,0"
                            Style="{StaticResource DialogSecondaryButton}"
                            Click="CopyDiagnosticsButton_Click" />
                    <Button Content="Close"
                            Width="80"
                            Margin="8,0,0,0"
                            IsDefault="True"
                            IsCancel="True"
                            Style="{StaticResource DialogPrimaryButton}"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
