<ui:FluentWindow x:Class="WindowsGSH.ServerInfoWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Server Info"
                 Width="1120"
                 Height="780"
                 MinWidth="960"
                 MinHeight="680"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResizeWithGrip"
                 ExtendsContentIntoTitleBar="True"
                 Icon="WindowsGSH.ico"
                 Background="{DynamicResource WorkspaceBrush}">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- See ExitDecisionWindow.xaml for why this is merged locally, not in App.xaml. -->
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource WorkspaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="ServerInfoTitleBar"
                     Grid.Row="0"
                     Title="Server Info"
                     Background="{DynamicResource WindowChromeBrush}"
                     Foreground="{DynamicResource TopBarTextBrush}"
                     ButtonsForeground="{DynamicResource TopBarTextBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="WindowsGSH.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1"
              Margin="22"
              Background="{DynamicResource WorkspaceBrush}"
              TextElement.Foreground="{DynamicResource TextBrush}"
              PreviewMouseLeftButtonDown="ContentGrid_PreviewMouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleTextBlock" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="SubtitleTextBlock" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="SteamCustomArgumentsWarningTextBlock"
                           Margin="0,6,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarnMetricText}"
                           Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,14">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="InfoTabButton" Content="Info" MinWidth="96" Style="{StaticResource DialogTabButton}" Click="InfoTabButton_Click" />
                    <Button x:Name="ConsoleTabButton" Content="Console" MinWidth="96" Margin="8,0,0,0" Style="{StaticResource DialogTabButton}" Click="ConsoleTabButton_Click" />
                    <Button x:Name="NetworkingTabButton" Content="Networking" MinWidth="110" Margin="8,0,0,0" Style="{StaticResource DialogTabButton}" Click="NetworkingTabButton_Click" />
                    <Button x:Name="HealthTabButton" Content="Health" MinWidth="96" Margin="8,0,0,0" Style="{StaticResource DialogTabButton}" Click="HealthTabButton_Click" />
                    <Button x:Name="ApiActionsButton" Content="API" MinWidth="96" Margin="8,0,0,0" Style="{StaticResource DialogTabButton}" Click="ApiActionsButton_Click" />
                </StackPanel>
                <Button x:Name="ForceStopButton"
                        Content="Force Stop"
                        Width="110"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource BadMetricBackground}"
                        Foreground="{DynamicResource BadMetricText}"
                        BorderBrush="{DynamicResource BadMetricBorder}"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Click="ForceStopButton_Click" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid x:Name="InfoView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="12" Margin="0,0,10,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Steam App" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="SteamAppTextBlock" Margin="0,4,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Padding="12" Margin="0,0,10,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Branch" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="BranchTextBlock" Margin="0,4,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Padding="12" Margin="0,0,10,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="PID" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="PidTextBlock" Margin="0,4,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Padding="12" Margin="0,0,10,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="CPU" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="CpuTextBlock" Margin="0,4,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Padding="12" Margin="0,0,10,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Memory" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="MemoryTextBlock" Margin="0,4,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="5" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Players" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="PlayersTextBlock" Margin="0,4,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1.35*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="Query Details" FontWeight="SemiBold" FontSize="15" />
                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                    <StackPanel Margin="0,0,12,10">
                                        <TextBlock Text="Map" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock x:Name="QueryMapTextBlock" Text="--" Margin="0,3,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Game / Version" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock x:Name="QueryGameVersionTextBlock" Text="--" Margin="0,3,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Protocol" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock x:Name="QueryProtocolTextBlock" Text="--" Margin="0,3,0,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Query Duration" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock x:Name="QueryDurationTextBlock" Text="--" Margin="0,3,0,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock x:Name="QueryStateTextBlock" Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                                <Border x:Name="QueryDiagnosticPanel" Margin="0,10,0,0" Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="Latest Query Diagnostic" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock x:Name="QueryDiagnosticTextBlock" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Players" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="PlayerListStateTextBlock" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                                <Border Margin="0,10,0,0" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="10,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Name" FontWeight="SemiBold" Opacity="0.7" />
                                            <TextBlock Grid.Column="1" Text="Score" FontWeight="SemiBold" Opacity="0.7" />
                                            <TextBlock Grid.Column="2" Text="Ping" FontWeight="SemiBold" Opacity="0.7" />
                                            <TextBlock Grid.Column="3" Text="Duration" FontWeight="SemiBold" Opacity="0.7" />
                                        </Grid>
                                        <ScrollViewer Grid.Row="1" MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="PlayersItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="10,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="90" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ScoreText}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding PingText}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" MinHeight="230" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="140" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ChartTitleTextBlock" Text="CPU Over Time" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="CpuChartButton" Content="CPU" MinWidth="72" Height="30" Style="{StaticResource DialogTabButton}" Click="CpuChartButton_Click" />
                                    <Button x:Name="MemoryChartButton" Content="Memory" MinWidth="86" Height="30" Margin="8,0,0,0" Style="{StaticResource DialogTabButton}" Click="MemoryChartButton_Click" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,14,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="ChartScalePanel" Background="#101218">
                                    <TextBlock x:Name="ChartScaleMaxTextBlock" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="ChartScaleMidTextBlock" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="ChartScaleMinTextBlock" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,4" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                </Grid>
                                <Canvas x:Name="ChartCanvas" Grid.Column="1" Background="#101218" SizeChanged="ChartCanvas_SizeChanged">
                                    <Polyline x:Name="MetricLine" Stroke="#57B8E6" StrokeThickness="2" />
                                </Canvas>
                            </Grid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Current" Opacity="0.65" />
                                <TextBlock x:Name="ChartCurrentTextBlock" Text="--" Margin="6,0,22,0" FontWeight="SemiBold" />
                                <TextBlock Text="Average" Opacity="0.65" />
                                <TextBlock x:Name="ChartAverageTextBlock" Text="--" Margin="6,0,22,0" FontWeight="SemiBold" />
                                <TextBlock Text="Peak" Opacity="0.65" />
                                <TextBlock x:Name="ChartPeakTextBlock" Text="--" Margin="6,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="AddonsPanel" Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Addons" FontWeight="SemiBold" />
                            <ItemsControl x:Name="AddonsItemsControl" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12" Margin="0,0,0,10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0" Opacity="0.68" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Margin="0,4,0,0" Opacity="0.72" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Config" MinWidth="80" Height="30" Tag="{Binding}" Style="{StaticResource DialogSecondaryButton}" Click="AddonConfigButton_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="ConsoleView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Console toolbar: search, pause auto-scroll, copy visible, clear view -->
                    <Grid Margin="0,0,0,8">
                        <ui:TextBox x:Name="ConsoleSearchTextBox"
                                    MinHeight="36"
                                    Width="220"
                                    HorizontalAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    PlaceholderText="Search console…"
                                    TextChanged="ConsoleSearchTextBox_TextChanged" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="PauseConsoleButton"
                                    Content="Pause Auto-scroll"
                                    MinWidth="140"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource DialogSecondaryButton}"
                                    Click="PauseConsoleButton_Click" />
                            <Button Content="Copy Visible"
                                    MinWidth="105"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource DialogSecondaryButton}"
                                    Click="CopyConsoleButton_Click" />
                            <Button Content="Clear View"
                                    MinWidth="90"
                                    ToolTip="Hide current lines from this view. No log files are deleted."
                                    Style="{StaticResource DialogSecondaryButton}"
                                    Click="ClearConsoleButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#101218" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <TextBox x:Name="ConsoleTextBox"
                                 Style="{x:Null}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#DDE7F5"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 IsUndoEnabled="False"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalScrollBarVisibility="Auto" />
                    </Border>

                    <Border x:Name="ConsoleCommandPanel" Grid.Row="2" Margin="0,14,0,0" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Console Command" FontWeight="SemiBold" />
                            <StackPanel x:Name="ConsoleCommandInputPanel" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox x:Name="ConsoleCommandTextBox" Height="34" MinWidth="760" VerticalContentAlignment="Center" KeyDown="ConsoleCommandTextBox_KeyDown" />
                                <Button Content="Send" MinWidth="96" Margin="10,0,0,0" Style="{StaticResource DialogPrimaryButton}" Click="SendConsoleCommandButton_Click" />
                            </StackPanel>
                            <Border x:Name="ConsoleInputDisabledPanel"
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,0,0"
                                    Padding="10"
                                    Background="{DynamicResource WarnMetricBackground}"
                                    BorderBrush="{DynamicResource WarnMetricBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Console input was disabled after a command timed out."
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarnMetricText}" />
                                        <TextBlock Margin="0,4,12,0"
                                                   Text="The process stopped reading its stdin pipe. Restart the server to create a new console connection. RCON remains available when supported."
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <Button x:Name="RestartForConsoleButton"
                                            Grid.Column="1"
                                            Content="Restart Server"
                                            MinWidth="120"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogSecondaryButton}"
                                            Click="RestartForConsoleButton_Click" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="RconPanel" Grid.Row="3" Margin="0,14,0,0" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="RCON Command" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox x:Name="RconCommandTextBox" Height="34" MinWidth="760" VerticalContentAlignment="Center" />
                                <Button Content="Send" MinWidth="96" Margin="10,0,0,0" Style="{StaticResource DialogPrimaryButton}" Click="SendRconButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="NetworkingView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="14"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Server Networking" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="NetworkingSummaryTextBlock"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Text="Reviewing this server's configured ports and network status." />
                                </StackPanel>
                                <Button x:Name="RefreshNetworkingButton"
                                        Grid.Column="1"
                                        Content="Refresh"
                                        MinWidth="92"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource DialogSecondaryButton}"
                                        Click="RefreshNetworkingButton_Click" />
                                <Button x:Name="TestExternalReachabilityButton"
                                        Grid.Column="2"
                                        Content="Test External Reachability"
                                        MinWidth="190"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource DialogSecondaryButton}"
                                        Click="TestExternalReachabilityButton_Click"
                                        ToolTip="Enable external reachability checks in Settings &gt; Diagnostics to use this." />
                                <Button Grid.Column="3"
                                        Content="Copy Networking Summary"
                                        MinWidth="190"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource DialogSecondaryButton}"
                                        Click="CopyNetworkingSummaryButton_Click" />
                            </Grid>
                            <TextBlock Text="External reachability tests are user-triggered. They send only the port numbers shown below to probe.windowsgsh.com. Your public IP is observed by that service directly and is not returned to WindowsGSH. Server names, module/game names, and credentials are never sent. Cloudflare and UKHost4U may retain ordinary infrastructure access logs."
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="12"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="NetworkingItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}" CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold" VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid x:Name="HealthView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="14"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Server Health" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HealthSummaryTextBlock" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <Button x:Name="RefreshHealthButton" Grid.Column="1" Content="Refresh" MinWidth="92" Margin="12,0,0,0" Style="{StaticResource DialogSecondaryButton}" Click="RefreshHealthButton_Click" />
                                <Button Grid.Column="2" Content="Copy Support Summary" MinWidth="160" Margin="8,0,0,0" Style="{StaticResource DialogSecondaryButton}" Click="CopyHealthSummaryButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="12"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="HealthItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}" CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold" VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
