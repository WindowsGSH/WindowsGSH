# Auto-detect text files and normalize line endings
* text=auto

# Enforce CRLF for Windows source files
*.cs text eol=crlf
*.xaml text eol=crlf
*.xaml.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Use LF for markdown and docs
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.ttf binary
*.otf binary
