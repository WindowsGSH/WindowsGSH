<ui:FluentWindow x:Class="WindowsGSH.WindowsGsmServerImportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Import WindowsGSM Server"
                 Width="1080"
                 Height="760"
                 MinWidth="980"
                 MinHeight="680"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 Icon="WindowsGSH.ico"
                 Background="{DynamicResource WorkspaceBrush}"
                 Closing="Window_Closing">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- See ExitDecisionWindow.xaml for why this is merged locally, not in App.xaml. -->
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource WorkspaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Import WindowsGSM Server"
                     Background="{DynamicResource WindowChromeBrush}"
                     Foreground="{DynamicResource TopBarTextBrush}"
                     ButtonsForeground="{DynamicResource TopBarTextBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="WindowsGSH.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1"
              Margin="22"
              Background="{DynamicResource WorkspaceBrush}"
              TextElement.Foreground="{DynamicResource TextBrush}"
              PreviewMouseLeftButtonDown="ContentGrid_PreviewMouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Import WindowsGSM Server" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="Select a WindowsGSH module and a WindowsGSM server folder, then review the imported values before copying or adopting the server files."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Module" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox x:Name="ModuleComboBox"
                          Grid.Column="1"
                          MinHeight="36"
                          DisplayMemberPath="Name"
                          SelectionChanged="Input_Changed" />

                <TextBlock Grid.Row="1" Text="Server folder" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBox x:Name="ServerFolderTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Height="32"
                         Margin="0,12,8,0"
                         VerticalContentAlignment="Center"
                         TextChanged="Input_Changed" />
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Content="Browse"
                        Height="32"
                        Margin="0,12,0,0"
                        Style="{StaticResource DialogSecondaryButton}"
                        Click="BrowseButton_Click" />
                <CheckBox x:Name="CreateFirewallRulesCheckBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          Content="Create Windows Firewall rules after import"
                          Margin="0,10,0,0"
                          VerticalAlignment="Center"
                          Style="{StaticResource AppCheckBox}"
                          Foreground="{DynamicResource TextBrush}" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <TextBlock x:Name="StatusTextBlock" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                <Button x:Name="ScanButton"
                        Content="Scan"
                        Width="110"
                        Height="34"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DialogPrimaryButton}"
                        Click="ScanButton_Click" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="WarningsBorder"
                        Padding="12"
                        Margin="0,0,0,12"
                        Background="{DynamicResource WarnMetricBackground}"
                        BorderBrush="{DynamicResource WarnMetricBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="WarningsTextBlock"
                               Foreground="{DynamicResource WarnMetricText}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>

                <DataGrid x:Name="FieldsDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          ItemsSource="{Binding ImportRows}"
                          CellEditEnding="FieldsDataGrid_CellEditEnding"
                          CurrentCellChanged="FieldsDataGrid_CurrentCellChanged">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Missing">
                                    <Setter Property="Background" Value="{DynamicResource BadMetricBackground}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BadMetricText}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Review">
                                    <Setter Property="Background" Value="{DynamicResource WarnMetricBackground}" />
                                    <Setter Property="Foreground" Value="{DynamicResource WarnMetricText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Module field" Binding="{Binding Label}" IsReadOnly="True" Width="2*" />
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="1.7*" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2.2*" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" IsReadOnly="True" Width="1.5*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" IsReadOnly="True" Width="1*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <TextBlock x:Name="FooterTextBlock"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close"
                            Width="92"
                            Height="34"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Style="{StaticResource DialogSecondaryButton}"
                            Click="CloseButton_Click" />
                    <Button x:Name="AdoptButton"
                            Content="Adopt"
                            Width="110"
                            Height="34"
                            Margin="0,0,8,0"
                            Style="{StaticResource DialogSecondaryButton}"
                            Click="AdoptButton_Click" />
                    <Button x:Name="CopyButton"
                            Content="Copy"
                            Width="110"
                            Height="34"
                            IsDefault="True"
                            Style="{StaticResource DialogPrimaryButton}"
                            Click="CopyButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
